{
  "name": "@jeb/youtube",
  "version": "0.0.0-testing-jsr-2",
  "exports": {
    "./youtube": "./src/youtube.ts",
    "./scan": "./src/bin/scan.ts",
    "./aggregate": "./src/bin/aggregate.ts",
    "./publish": "./src/bin/publish.ts",
    "./curate": "./src/bin/seasoning.ts",
    "./scan-dropout": "./src/bin/dropout.ts"
  },
  "unstable": ["temporal"],
  "tasks": {
    "check": "deno check src/bin/scan.ts src/bin/aggregate.ts src/bin/publish.ts src/bin/seasoning.ts src/bin/dropout.ts && deno lint && deno fmt --check",
    "scan": "deno run --allow-read --allow-write=./data --allow-env --allow-net ./src/bin/scan.ts",
    "aggregate": "deno run --allow-read --allow-write=./data ./src/bin/aggregate.ts",
    "publish": "deno run --allow-read --allow-write=./data,./config --allow-env --allow-net ./src/bin/publish.ts",
    "curate": "deno run --allow-read --allow-write=./data --allow-env --allow-net ./src/bin/seasoning.ts",
    "scan-dropout": "deno run --allow-read --allow-write=./data --allow-env --allow-net ./src/bin/dropout.ts"
  },
  "imports": {
    "@std/async": "jsr:@std/async@^0.218.2",
    "@std/cli": "jsr:@std/cli@^0.218.2",
    "@std/collections": "jsr:@std/collections@^0.218.2",
    "@std/dotenv": "jsr:@std/dotenv@^0.218.2",
    "@std/json": "jsr:@std/json@^0.218.2",
    "@std/path": "jsr:@std/path@^0.218.2",
    "@std/toml": "jsr:@std/toml@^0.218.2",
    "@std/yaml": "jsr:@std/yaml@^0.218.2",
    "googleapis": "npm:googleapis@^133.0.0",
    "zod": "npm:zod@^3.22.4"
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "fmt": {
    "exclude": ["data/"]
  }
}
